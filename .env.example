# Copia este archivo a ".env" (o usa .streamlit/secrets.toml) y completa tus datos de Supabase.
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Clave de SERVICIO (service_role): la que usa la app. Solo vive en el servidor; nunca la subas a GitHub.
# Supabase → Project Settings → API → service_role.
SUPABASE_SERVICE_KEY=TU-CLAVE-SERVICE-ROLE

# Clave pública (anon / publishable). Solo hace falta en modo abierto (sin SUPABASE_SERVICE_KEY)
# y para comprobar que la base quedó cerrada (python scripts/check_security.py).
SUPABASE_KEY=TU-CLAVE-PUBLICA

# Secreto con el que se firma la cookie de sesión (cualquier texto largo y aleatorio).
# Si lo cambias, todas las sesiones abiertas se cierran.
SESSION_SECRET=CAMBIA-ESTO-POR-UN-TEXTO-LARGO-Y-ALEATORIO

# Contraseña con la que se cifran los respaldos automáticos (GitHub Actions) y scripts/backup.py.
BACKUP_PASSWORD=CAMBIA-ESTO
