# Copia este archivo a ".streamlit/secrets.toml" y completa tus datos de Supabase.
# Streamlit Cloud usa este archivo (o su equivalente en el panel de "Secrets") en vez de .env.
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"

# Clave de SERVICIO (service_role): la que usa la app. Supabase → Project Settings → API.
SUPABASE_SERVICE_KEY = "TU-CLAVE-SERVICE-ROLE"

# Clave pública (opcional si ya usas la de servicio).
SUPABASE_KEY = "TU-CLAVE-PUBLICA"

# Secreto para firmar la cookie de sesión (texto largo y aleatorio).
SESSION_SECRET = "CAMBIA-ESTO-POR-UN-TEXTO-LARGO-Y-ALEATORIO"
